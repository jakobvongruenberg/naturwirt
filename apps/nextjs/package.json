    "dayjs": "^1.11.10",
    "geist": "^1.2.2",
    "i18next": "^23.13.0",
    "lodash": "^4.17.21",
    "lottie-react": "^2.4.0",
    "next": "^14.1.0",
    "next-plausible": "^3.12.0",
    "react": "18.2.0",
    "react-div-100vh": "^0.7.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.50.1",
    "react-lottie": "^1.2.4",
    "react-responsive": "^9.0.2",
    "superjson": "2.2.1",
    "trpc-openapi": "^1.2.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
