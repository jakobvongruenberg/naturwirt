  "devDependencies": {
    "@farmers/env": "workspace:^0.1.0",
    "@farmers/eslint-config": "workspace:^0.2.0",
    "@farmers/prettier-config": "workspace:^0.1.0",
    "@farmers/tailwind-config": "workspace:^0.1.0",
    "@farmers/tsconfig": "workspace:^0.1.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.11.13",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-icons": "^3.0.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.56.0",
    "jiti": "^1.21.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@farmers/eslint-config/base",
      "@farmers/eslint-config/nextjs",
