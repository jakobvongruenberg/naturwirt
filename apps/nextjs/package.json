{
  "name": "@farmers/nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "TZ=UTC pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "dotenv -v SKIP_ENV_VALIDATION=1 next lint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@farmers/api": "workspace:^0.1.0",
    "@farmers/auth": "workspace:^0.1.0",
    "@farmers/db": "workspace:^0.1.0",
    "@farmers/language": "workspace:^0.1.0",
    "@farmers/shared": "workspace:^0.1.0",
    "@farmers/ui": "workspace:^0.1.0",
    "@farmers/validators": "workspace:^0.1.0",
    "@formkit/auto-animate": "^0.8.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@react-hook/window-size": "^3.1.1",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@tanstack/react-query": "^5.18.1",
    "@tanstack/react-query-devtools": "^5.18.1",
    "@tanstack/react-virtual": "^3.10.7",
    "@trpc/client": "11.0.0-next-beta.264",
    "@trpc/react-query": "11.0.0-next-beta.264",
