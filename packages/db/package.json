{
  "name": "@farmers/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "push": "pnpm with-env drizzle-kit push",
    "drop": "pnpm with-env drizzle-kit drop",
    "generate": "pnpm with-env drizzle-kit generate",
    "migrate": "pnpm with-env tsx src/migrate.ts",
    "seed": "pnpm with-env tsx ./src/seed.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@farmers/shared": "workspace:*",
    "drizzle-orm": "^0.31.2",
    "pg": "^8.11.5",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.1.0",
    "@farmers/env": "workspace:*",
    "@farmers/eslint-config": "workspace:*",
    "@farmers/prettier-config": "workspace:*",
    "@farmers/tsconfig": "workspace:*",
    "dotenv-cli": "^7.3.0",
    "drizzle-kit": "^0.22.7",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@farmers/eslint-config/base"
    ]
  },
  "prettier": "@farmers/prettier-config"
}
